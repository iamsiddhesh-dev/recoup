# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# Dashboard → Test mode → Account & Settings → API Keys → Generate Key.
# Recoup refuses to start if the key ID does not begin with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when creating the webhook (Account & Settings → Webhooks).
# The test-mode confirmation OTP on that screen is a fixed default: 754081
RAZORPAY_WEBHOOK_SECRET=

# --- LLM providers ----------------------------------------------------------
# Primary: batched calls, ~5-10 per run. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Development iteration: 14.4K requests/day absorbs repeated local runs.
GEMINI_DEV_MODEL=gemma-4-26b

# Fallback if Gemini errors mid-demo. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Offline safety net. Leave blank to disable.
OLLAMA_BASE_URL=

# --- Optional ---------------------------------------------------------------
# One real outbound email path; every other channel is mocked.
RESEND_API_KEY=

# LLM tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
