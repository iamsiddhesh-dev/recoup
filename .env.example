# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# Dashboard → Test mode → Account & Settings → API Keys → Generate Key.
# Recoup refuses to start if the key ID does not begin with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when creating the webhook (Account & Settings → Webhooks).
# The test-mode confirmation OTP on that screen is a fixed default: 754081
RAZORPAY_WEBHOOK_SECRET=

# --- LLM providers ----------------------------------------------------------
# None of these are needed to reproduce the reported numbers. Model responses are
# cached to cache/llm/ and committed, so `recoup eval` replays them offline. Keys
# are only needed to regenerate the cache after changing a prompt.
#
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Gemini Flash allows 20 requests/day; Gemma allows 14,400 on the same key. Set
# RECOUP_LLM_DEV=1 to iterate on prompts against Gemma without spending the Flash
# budget, then unset it for the run whose cache gets committed.
GEMINI_DEV_MODEL=gemma-4-26b
RECOUP_LLM_DEV=

# Fallback when Gemini errors or its daily budget is spent.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional ---------------------------------------------------------------
# One real outbound email path; every other channel is mocked.
RESEND_API_KEY=

# LLM tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
