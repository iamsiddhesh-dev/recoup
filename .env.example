# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Nothing here is required to reproduce the numbers in the README. `make eval`,
# `make demo` and `make test` all run with this file absent: the world is
# generated from a seed and every model response is committed to cache/llm/.
#
# These keys are only needed for two optional things — exercising the live
# adapter, and regenerating the LLM cache after changing a prompt.

# --- Razorpay (TEST MODE ONLY) ---------------------------------------------
# Dashboard -> Test mode -> Account & Settings -> API Keys -> Generate Key.
# RazorpayTestAdapter refuses to construct unless the key ID starts with
# rzp_test_, so a live money action is impossible rather than merely unlikely.
# Needed only for `python -m recoup probe`.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when creating the webhook (Account & Settings -> Webhooks). Signatures are
# verified against it, so an unsigned POST to /webhooks/razorpay is rejected.
# The test-mode confirmation OTP on that screen is a fixed default: 754081
RAZORPAY_WEBHOOK_SECRET=

# --- LLM providers ----------------------------------------------------------
# Four batched calls per run: one classifying every unmapped error in the batch,
# three generating the copy matrix (one per language). A per-payment call would
# need ~1,500 requests and is impossible on any free tier — see the README.
#
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Flash allows 20 requests/day; Gemma allows 14,400 on the same key. Set
# RECOUP_LLM_DEV=1 to iterate on prompts against Gemma without spending the
# Flash budget, then unset it for the run whose cache gets committed.
GEMINI_DEV_MODEL=gemma-4-26b
RECOUP_LLM_DEV=

# Fallback when Gemini errors or its daily budget is spent. The client retries a
# provider once on a transient 5xx before falling through to the next one.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
